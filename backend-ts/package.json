{
  "name": "fitness-tracker-backend-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "frontend",
    "openapi.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build:bundle": "tsc --noEmit && esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/lambda.cjs",
    "build": "npm run clean && npm run build:bundle",
    "build:cutover": "npm run build && node scripts/prepare-frontend-build.mjs",
    "prepack": "npm run build:bundle",
    "clean:test": "node scripts/clean-test.mjs",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run test:integration",
    "test:integration": "npm run build:test && find .tmp/ts-build/tests -type f -name '*.test.js' -print0 | xargs -0 node --test --test-concurrency=1",
    "rehearsal:migration": "npm run build:test && node scripts/run-migration-rehearsal.mjs",
    "export:sqlite": "node scripts/export-sqlite-snapshot.mjs",
    "verify:artifact": "npm run build:cutover && sam build --template template.yaml --build-dir .tmp/sam-build && node scripts/verify-lambda-artifact.mjs",
    "dev": "npm run build:test && node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.927.0",
    "@aws-sdk/lib-dynamodb": "^3.927.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "dynamodb-local": "^0.0.38",
    "esbuild": "^0.27.2",
    "typescript": "~5.9.3"
  }
}
